+import com.ywpc.tlkey.ui.setupEdgeToEdge
+
+class PowerWidgetConfigureActivity : AppCompatActivity() {
+    private var widgetId = AppWidgetManager.INVALID_APPWIDGET_ID
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setResult(RESULT_CANCELED)
+        widgetId = intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, AppWidgetManager.INVALID_APPWIDGET_ID)
+    }
+    override fun onResume() {
+        super.onResume()
+        showConfiguration()
+    }
+    private fun showConfiguration() {
+        val app = application as App
+        val padding = (24 * resources.displayMetrics.density).toInt()
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL; gravity = Gravity.CENTER_VERTICAL
+            setPadding(padding, padding, padding, padding)
+        }
+        setContentView(root)
+        setupEdgeToEdge(root)
+        androidx.core.view.ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
+            val bars = insets.getInsets(androidx.core.view.WindowInsetsCompat.Type.systemBars())
+            view.setPadding(padding + bars.left, padding + bars.top, padding + bars.right, padding + bars.bottom)
+            insets
+        }
+        fun text(value: String, size: Float) = TextView(this).apply {
+            text = value; textSize = size; setPadding(0, 12, 0, 24); root.addView(this)
+        }
+        fun button(value: String, action: () -> Unit) = MaterialButton(this).apply {
+            text = value; setOnClickListener { action() }; root.addView(this)
+        }
+        text("TL-key 桌面控车", 26f)
+        text("一张卡片，固定控制一辆车。\n点击上电或下电，图标变蓝；下电成功 1 分钟后恢复默认色。\n\n蓝色是操作反馈，不代表实时车况。下电请在停车后操作。", 16f)
+        if (!app.loginManager.hasSession()) {
+            text("先登录台铃账号，再回来选择车辆。", 16f)
+            button("登录 TL-key") { startActivity(Intent(this, LoginActivity::class.java)) }
+            return
+        }
+        val vehicles = app.loginManager.cachedVehicles()
+        if (vehicles.isEmpty()) {
+            text("尚未添加车辆，请先在 TL-key 中完成添加和配对。", 16f)
+            button("打开 TL-key") { startActivity(Intent(this, MainActivity::class.java)) }
+            return
+        }
+        val oldId = PowerWidgetStore(this).read(widgetId).vehicleId
+        var selected = vehicles.indexOfFirst { it.id == oldId }.takeIf { it >= 0 } ?: 0
+        val labels = vehicles.map { "${it.name.ifBlank { "我的台铃" }} · ${it.id.takeLast(4)}" }.toTypedArray()
+        val selection = button("车辆：${labels[selected]} ▾") { }
+        selection.setOnClickListener {
+            MaterialAlertDialogBuilder(this).setTitle("选择小组件控制的车辆")
+                .setSingleChoiceItems(labels, selected) { dialog, index ->
+                    selected = index; selection.text = "车辆：${labels[index]} ▾"; dialog.dismiss()
+                }.setNegativeButton("取消", null).show()
+        }
+        button(if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) "添加到桌面" else "保存小组件") {
+            val vehicle = vehicles[selected]
+            val uid = app.authRepository.currentUid().orEmpty()
+            if (uid.isBlank() || !vehicle.hasBleCredentials) {
+                Toast.makeText(this, "请先在首页选择这辆车，完成配对后再添加", Toast.LENGTH_LONG).show()
+                startActivity(Intent(this, MainActivity::class.java)); return@button
+            }
+            if (widgetId != AppWidgetManager.INVALID_APPWIDGET_ID) {
+                if (!PowerWidgetProvider.exists(this, widgetId)) { finish(); return@button }
+                PowerWidgetStore(this).write(widgetId, PowerWidgetState(vehicleId = vehicle.id, ownerUid = uid))
+                PowerWidgetProvider.render(this, widgetId)
+                setResult(RESULT_OK, Intent().putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, widgetId))
+                finish()
+            } else {
+                val manager = AppWidgetManager.getInstance(this)
+                if (!manager.isRequestPinAppWidgetSupported) {
+                    MaterialAlertDialogBuilder(this).setTitle("从桌面添加")
+                        .setMessage("长按桌面空白处 → 小组件 / 小工具 → TL-key 桌面控车，拖到桌面后选择车辆。")
+                        .setPositiveButton("知道了", null).show()
+                    return@button
+                }
+                // The launcher supplies the allocated widget ID as a fill-in extra.
+                val callback = PendingIntent.getBroadcast(this, 0,
+                    Intent(this, PowerWidgetPinnedReceiver::class.java).apply {
+                        data = Uri.parse("tlkey-pin://${java.util.UUID.randomUUID()}")
+                        putExtra("vehicle", vehicle.id); putExtra("owner", uid)
+                    }, PendingIntent.FLAG_ONE_SHOT or PendingIntent.FLAG_MUTABLE)
+                manager.requestPinAppWidget(ComponentName(this, PowerWidgetProvider::class.java), null, callback)
+            }
+        }
+        button("返回") { finish() }
+    }
+}
+
+class PowerWidgetPinnedReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val id = intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, -1)
+        if (!PowerWidgetProvider.exists(context, id)) return
+        val state = PowerWidgetState(vehicleId = intent.getStringExtra("vehicle").orEmpty(),
+            ownerUid = intent.getStringExtra("owner").orEmpty())
+        if (!PowerWidgetProvider.valid(context, state)) return
+        PowerWidgetStore(context).write(id, state)
+        PowerWidgetProvider.render(context, id)
+    }
+}
diff --git a/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetControlService.kt b/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetControlService.kt
new file mode 100644
index 0000000..5dda1ae
--- /dev/null
+++ b/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetControlService.kt
@@ -0,0 +1,133 @@
+package com.ywpc.tlkey.widget
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.appwidget.AppWidgetManager
+import android.content.Intent
+import android.os.IBinder
+import com.ywpc.tlkey.App
+import com.ywpc.tlkey.R
+import com.ywpc.tlkey.control.ControlResult
+import com.ywpc.tlkey.control.userMessage
+import com.ywpc.tlkey.protocol.ControlAction
+import com.ywpc.tlkey.ui.MainActivity
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.UUID
+
+/** Foreground only while executing a user tap / completing its short feedback timer. */
+class PowerWidgetControlService : Service() {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+    private var operation: Job? = null
+    private val resets = mutableMapOf<Int, Job>()
+
+    override fun onCreate() {
+        super.onCreate()
+        getSystemService(NotificationManager::class.java).createNotificationChannel(
+            NotificationChannel(CHANNEL, "桌面控车", NotificationManager.IMPORTANCE_LOW))
+        startForeground(NOTIFICATION, notification("正在处理桌面控车"))
+    }
+    override fun onBind(intent: Intent?): IBinder? = null
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        val id = intent?.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, -1) ?: -1
+        val action = intent?.getStringExtra("power_action")
+        if (!PowerWidgetProvider.exists(this, id) || action !in listOf(PowerWidgetState.ON, PowerWidgetState.OFF)) {
+            stopIfIdle(); return START_NOT_STICKY
+        }
+        if (operation?.isActive == true) {
+            val store = PowerWidgetStore(this)
+            val state = store.read(id)
+            if (state.pendingUntil == 0L) {
+                resets.remove(id)?.cancel()
+                store.write(id, state.copy(selected = "", resetAt = 0,
+                    message = "正在执行其他操作，请稍后重试", updatedAt = System.currentTimeMillis()))
+                PowerWidgetProvider.render(this, id)
+            }
+            return START_NOT_STICKY
+        }
+        val store = PowerWidgetStore(this)
+        val initial = store.read(id)
+        if (!PowerWidgetProvider.valid(this, initial)) {
+            PowerWidgetProvider.render(this, id); stopIfIdle(); return START_NOT_STICKY
+        }
+        resets.remove(id)?.cancel()
+        val token = UUID.randomUUID().toString()
+        store.write(id, initial.begin(action!!, token, System.currentTimeMillis()))
+        PowerWidgetProvider.render(this, id)
+        // Dispatch normally so operation is assigned before its finally block runs.
+        operation = scope.launch(start = kotlinx.coroutines.CoroutineStart.DEFAULT) {
+            // Main.immediate may execute inline; yield before touching the lifecycle bookkeeping.
+            kotlinx.coroutines.yield()
+            try {
+                val result = withTimeoutOrNull(PowerWidgetState.OPERATION_TIMEOUT_MS) {
+                    (application as App).controller.control(
+                        if (action == PowerWidgetState.ON) ControlAction.POWER_ON else ControlAction.POWER_OFF,
+                        initial.vehicleId,
+                    )
+                }
+                val success = result is ControlResult.Success
+                val feedback = when {
+                    result == null -> "操作超时，请确认车辆状态"
+                    success -> if (action == PowerWidgetState.ON) "上次：上电指令成功" else "上次：下电指令成功"
+                    else -> result.userMessage()
+                }
+                if (PowerWidgetProvider.exists(this@PowerWidgetControlService, id) &&
+                    PowerWidgetProvider.valid(this@PowerWidgetControlService, store.read(id))) {
+                    val completed = store.read(id).complete(token, success, feedback, System.currentTimeMillis())
+                    store.write(id, completed)
+                    PowerWidgetProvider.render(this@PowerWidgetControlService, id)
+                    if (completed.resetAt > 0) {
+                        getSystemService(NotificationManager::class.java).notify(NOTIFICATION,
+                            notification("下电成功，图标将在 1 分钟后恢复默认色"))
+                        resets[id] = scope.launch {
+                            delay((completed.resetAt - System.currentTimeMillis()).coerceAtLeast(0))
+                            // Reconcile the current generation, never overwrite a newer tap.
+                            PowerWidgetProvider.render(this@PowerWidgetControlService, id)
+                            resets.remove(id)
+                            stopIfIdle()
+                        }
+                    }
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                if (PowerWidgetProvider.exists(this@PowerWidgetControlService, id)) {
+                    store.write(id, store.read(id).complete(token, false, "控车失败，请重试", System.currentTimeMillis()))
+                    PowerWidgetProvider.render(this@PowerWidgetControlService, id)
+                }
+            } finally {
+                operation = null
+                stopIfIdle()
+            }
+        }
+        return START_NOT_STICKY
+    }
+    private fun stopIfIdle() {
+        if (operation == null && resets.isEmpty()) {
+            stopForeground(STOP_FOREGROUND_REMOVE)
+            stopSelf()
+        }
+    }
+    private fun notification(message: String): Notification {
+        val content = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        return Notification.Builder(this, CHANNEL).setSmallIcon(R.drawable.ic_power)
+            .setContentTitle("TL-key 桌面控车").setContentText(message)
+            .setContentIntent(content).setOngoing(true).build()
+    }
+    override fun onDestroy() { scope.cancel(); super.onDestroy() }
+    companion object {
+        private const val CHANNEL = "widget_control"
+        private const val NOTIFICATION = 401
+    }
+}
diff --git a/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetProvider.kt b/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetProvider.kt
new file mode 100644
index 0000000..3161dd8
--- /dev/null
+++ b/client/app/src/main/java/com/ywpc/tlkey/widget/PowerWidgetProvider.kt
@@ -0,0 +1,134 @@
+package com.ywpc.tlkey.widget
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.widget.RemoteViews
+import androidx.core.content.ContextCompat
+import com.ywpc.tlkey.App
+import com.ywpc.tlkey.R
+import com.ywpc.tlkey.ui.MainActivity
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+class PowerWidgetProvider : AppWidgetProvider() {
+    override fun onUpdate(context: Context, manager: AppWidgetManager, ids: IntArray) {
+        ids.forEach { render(context, it) }
+    }
+
+    override fun onAppWidgetOptionsChanged(context: Context, manager: AppWidgetManager, id: Int, options: Bundle) {
+        render(context, id)
+    }
+
+    override fun onDeleted(context: Context, ids: IntArray) {
+        ids.forEach { id ->
+            PowerWidgetStore(context).remove(id)
+            alarm(context, id)?.let { context.getSystemService(AlarmManager::class.java).cancel(it) }
+        }
+    }
+
+    override fun onRestored(context: Context, oldWidgetIds: IntArray, newWidgetIds: IntArray) {
+        oldWidgetIds.zip(newWidgetIds).forEach { (old, new) ->
+            val store = PowerWidgetStore(context)
+            store.write(new, store.read(old).copy(selected = "", pendingUntil = 0, resetAt = 0, message = "点击按钮控车", updatedAt = 0))
+            store.remove(old)
+            render(context, new)
+        }
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        when (intent.action) {
+            ACTION_REFRESH -> {
+                val id = intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, -1)
+                if (exists(context, id)) render(context, id)
+            }
+            Intent.ACTION_BOOT_COMPLETED, Intent.ACTION_MY_PACKAGE_REPLACED,
+            Intent.ACTION_TIME_CHANGED, Intent.ACTION_TIMEZONE_CHANGED -> refreshAll(context)
+        }
+    }
+
+    companion object {
+        const val ACTION_REFRESH = "com.ywpc.tlkey.widget.REFRESH"
+        fun ids(context: Context): IntArray = AppWidgetManager.getInstance(context)
+            .getAppWidgetIds(ComponentName(context, PowerWidgetProvider::class.java))
+        fun exists(context: Context, id: Int) = id in ids(context)
+        fun refreshAll(context: Context) { ids(context).forEach { render(context, it) } }
+
+        fun valid(context: Context, state: PowerWidgetState): Boolean {
+            val app = context.applicationContext as App
+            return state.vehicleId.isNotBlank() && state.ownerUid.isNotBlank() &&
+                app.loginManager.hasSession() && app.authRepository.currentUid() == state.ownerUid &&
+                app.vehicleRepository.find(state.vehicleId) != null
+        }
+
+        fun render(context: Context, id: Int) {
+            if (!exists(context, id)) return
+            val store = PowerWidgetStore(context)
+            val original = store.read(id)
+            var state = original.reconcile(System.currentTimeMillis())
+            val valid = valid(context, state)
+            if (!valid) state = state.copy(selected = "", resetAt = 0, pendingUntil = 0,
+                message = if (state.vehicleId.isBlank()) "点此选择车辆" else "请打开 TL-key 重新配置")
+            if (state != original) store.write(id, state)
+            val app = context.applicationContext as App
+            val vehicle = if (valid) app.vehicleRepository.find(state.vehicleId) else null
+            val views = RemoteViews(context.packageName, R.layout.widget_power)
+            views.setTextViewText(R.id.widget_vehicle, vehicle?.let {
+                "${it.name.ifBlank { "我的台铃" }} · ${it.id.takeLast(4)}"
+            } ?: "选择车辆 ›")
+            views.setTextViewText(R.id.widget_status, state.message)
+            views.setTextViewText(R.id.widget_time, if (state.updatedAt == 0L) "操作反馈 · 非实时车况" else
+                "${SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date(state.updatedAt))} · 操作反馈")
+            val defaultColor = ContextCompat.getColor(context, R.color.widget_icon_default)
+            val blue = ContextCompat.getColor(context, R.color.widget_blue)
+            views.setInt(R.id.widget_on_icon, "setColorFilter", if (state.selected == PowerWidgetState.ON) blue else defaultColor)
+            views.setInt(R.id.widget_off_icon, "setColorFilter", if (state.selected == PowerWidgetState.OFF) blue else defaultColor)
+            views.setBoolean(R.id.widget_on, "setEnabled", state.pendingUntil == 0L)
+            views.setBoolean(R.id.widget_off, "setEnabled", state.pendingUntil == 0L)
+            views.setOnClickPendingIntent(R.id.widget_on, activity(context, id, PowerWidgetState.ON))
+            views.setOnClickPendingIntent(R.id.widget_off, activity(context, id, PowerWidgetState.OFF))
+            views.setOnClickPendingIntent(R.id.widget_vehicle, activity(context, id, "configure"))
+            views.setOnClickPendingIntent(R.id.widget_status, activity(context, id, if (valid) "open" else "configure"))
+            views.setOnClickPendingIntent(R.id.widget_title, activity(context, id, "open"))
+            AppWidgetManager.getInstance(context).updateAppWidget(id, views)
+            val deadline = if (state.pendingUntil != 0L) state.pendingUntil else state.resetAt
+            val alarms = context.getSystemService(AlarmManager::class.java)
+            val pending = alarm(context, id)!!
+            if (deadline > 0) {
+                // Process-independent fallback. Interactive 60s reset is also handled by the service.
+                alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, deadline, pending)
+            } else alarms.cancel(pending)
+        }
+
+        private fun activity(context: Context, id: Int, action: String): PendingIntent {
+            val target = when (action) {
+                "configure" -> PowerWidgetConfigureActivity::class.java
+                "open" -> MainActivity::class.java
+                else -> PowerWidgetActionActivity::class.java
+            }
+            val intent = Intent(context, target).apply {
+                data = Uri.parse("tlkey-widget://$id/$action")
+                putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, id)
+                putExtra("power_action", action)
+                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            }
+            return PendingIntent.getActivity(context, id, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        }
+
+        private fun alarm(context: Context, id: Int): PendingIntent? = PendingIntent.getBroadcast(
+            context, id, Intent(context, PowerWidgetProvider::class.java).apply {
+                action = ACTION_REFRESH; data = Uri.parse("tlkey-widget://$id/reset")
+                putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, id)
+            }, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+    }
+}
